# Copia este archivo como ".env.local" y rellena los valores: lo leen la web y la API Python (un solo archivo).
# NUNCA subas los archivos .env al repositorio. En Vercel van en Settings → Environment Variables.

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("publishable" o "anon"): puede ir al navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta ("secret" o "service_role"): SOLO servidor. Se usa para crear usuarios con código + PIN.
SUPABASE_SECRET_KEY=

# ---------- DECA (API Python) ----------
# "mock" = datos simulados (no toca Odoo). "real" = Odoo de verdad.
ODOO_MODE=mock
# true = hace todo MENOS escribir/publicar/imprimir en Odoo
DRY_RUN=true
ODOO_URL=
ODOO_DB=
ODOO_USER=
# Clave API o contraseña del usuario técnico de Odoo
ODOO_PASSWORD=
# Contraseña web (solo para imprimir el PDF; el usuario técnico sin 2FA). Si se deja vacía se usa ODOO_PASSWORD
ODOO_WEB_PASSWORD=
# 1 = STINSA, 7 = TRANSARGI S.L.U
ODOO_COMPANY_IDS=1,7
# Clave larga y aleatoria para firmar las sesiones de edición de órdenes (obligatoria en modo real)
SECRET_KEY=
EDITABLE_STAGES=nuevo,en desarrollo
PESO_AVISO_KG=27000
QR_ALLOWED_HOSTS=

# ---------- Fichaje y ausencias → Odoo ----------
# true = no escribe en Odoo (los marca «modo prueba»). Independiente del DRY_RUN de DECA.
RRHH_DRY_RUN=true
# Opcional: el tipo de ausencia de Odoo se elige solo por su nombre. Solo para forzar alguno (ids de Odoo):
# ODOO_TIPOS_AUSENCIA={"vacaciones":1,"asuntos_propios":2,"medico":3,"otro":4}

# ---------- Sincronización automática con Odoo ----------
# Texto largo al azar (p. ej. `openssl rand -hex 32`). Vercel lo manda solo a su cron diario; sin él no hay pasada automática.
# La pasada también necesita SUPABASE_SECRET_KEY (arriba).
CRON_SECRET=

# ---------- Movildata ----------
# Clave privada de https://mapi.movildata.com/Help: SOLO servidor, marcar Sensitive en Vercel.
MOVILDATA_API_KEY=
# real = API oficial; mock = pruebas (no muestra flota real).
# Si se omite MOVILDATA_MODE, una clave configurada activa el modo real.
MOVILDATA_MODE=real
# Dirección pública de la app (opcional; en Vercel se usa sola la de producción)
# APP_URL=https://app-two-omega-92.vercel.app

# ---------- Calendario de Outlook (opcional) ----------
# NO activar hasta que IT conceda en Entra «offline_access» y «Calendars.ReadWrite» (docs/configuracion-inicial.md, apartado 2).
OUTLOOK_CALENDARIO=false
# De la app de Entra «App Grupo Trimodos»: id de aplicación, VALOR del secreto (Sensitive) e id de directorio.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ---------- Login con Google para chóferes y operarios (opcional) ----------
# true cuando Google esté activado en Supabase (docs/configuracion-inicial.md, apartado 3); si no, el botón no sale.
LOGIN_GOOGLE=false
# Opcional: campo propio de la ficha de empleado de Odoo con el correo con el que entra cada uno (p. ej. x_correo_app).
# Sin él, el enlace con Odoo usa el «Correo de trabajo».
# ODOO_CAMPO_CORREO=x_correo_app

# ---------- ARGON (lo llama n8n) ----------
ARGON_CLAVE=
ARGON_ODOO_URL=
ARGON_ODOO_DB=
ARGON_ODOO_USER=
ARGON_ODOO_PASSWORD=
# ARGON_CONFIG={"cliente_id":1585,"empresa_id":1,"tipo_pedido_id":41,"fecha_inicio":"2026-10-15"}
# ARGON_PERMITIR_PRODUCCION=1
